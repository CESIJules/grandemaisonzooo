[Unit]
Description=Grande Maison Zoo - Next.js Radio Frontend
After=network.target icecast2.service liquidsoap.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/var/www/frontend/.env.local
ExecStart=/usr/bin/node /var/www/frontend/.next/standalone/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
