##########################################################
# IGNORE TOUT PAR DÉFAUT
###########################################################
/*

###########################################################
# EXCEPTIONS (whitelist)
###########################################################

############# /var #############
!/var/
/var/*

!/var/www/
!/var/www/html/
# Ignorer le repo interne du site
/var/www/html/.git
/var/www/html/.git/**
# Suivre tous les fichiers du site
!/var/www/html/**
# APRÈS l'inclusion, exclure les fichiers spécifiques
/var/www/data/
/var/www/html/vid/
/var/www/html/uploads/**
!/var/www/html/uploads/.gitkeep
/var/www/html/music_metadata.json
/var/www/html/track_info.json
/var/www/html/introboucle_old.mp4

# ---- Frontend Next.js ----
!/var/www/frontend/
/var/www/frontend/**

# Whitelister les fichiers source (tout sauf les artefacts de build/runtime)
!/var/www/frontend/app/
!/var/www/frontend/app/**
!/var/www/frontend/hooks/
!/var/www/frontend/hooks/**
!/var/www/frontend/components/
!/var/www/frontend/components/**
!/var/www/frontend/lib/
!/var/www/frontend/lib/**
!/var/www/frontend/types/
!/var/www/frontend/types/**
!/var/www/frontend/public/
!/var/www/frontend/public/**
!/var/www/frontend/data/
!/var/www/frontend/data/artists.json
!/var/www/frontend/data/timeline.json
# artists_profiles.json contient des données live, pas tracké
/var/www/frontend/data/artists_profiles.json
!/var/www/frontend/package.json
!/var/www/frontend/package-lock.json
!/var/www/frontend/tsconfig.json
!/var/www/frontend/next.config.ts
!/var/www/frontend/eslint.config.mjs
!/var/www/frontend/middleware.ts
!/var/www/frontend/.gitignore

# Exclure les artefacts générés et secrets
/var/www/frontend/.next/
/var/www/frontend/node_modules/
/var/www/frontend/.env*.local

############# /home #############
!/home/
/home/*

# Autoriser /home/radio
!/home/radio/
/home/radio/*

# Suivre les fichiers .liq et playlist
!/home/radio/radio.liq
!/home/radio/metadata.liq
!/home/radio/playlist.m3u

# Suivre seulement le DOSSIER musique (pas les mp3)
!/home/radio/musique/
/home/radio/musique/*

############# /etc #############
!/etc/
/etc/*

# ---- systemd ----
!/etc/systemd/
/etc/systemd/*

!/etc/systemd/system/
/etc/systemd/system/*

# Suivre liquidsoap + icecast2 service
!/etc/systemd/system/liquidsoap.service
!/etc/systemd/system/liquidsoap@.service
!/etc/systemd/system/liquidsoap.service.d/
/etc/systemd/system/liquidsoap.service.d/*
!/etc/systemd/system/liquidsoap.service.d/**
!/etc/systemd/system/icecast2.service
!/etc/systemd/system/gmz-frontend.service

# ---- icecast2 ----
!/etc/icecast2/
/etc/icecast2/*

# Suivre icecast.xml seulement
!/etc/icecast2/icecast.xml

# Ne PAS suivre admin/ ni web/
/etc/icecast2/admin/
/etc/icecast2/web/

# ---- default ----
!/etc/default/
/etc/default/*
!/etc/default/icecast2

# ---- NGINX ----
!/etc/nginx/
/etc/nginx/*

# nginx.conf
!/etc/nginx/nginx.conf

# sites-available + sites-enabled + conf.d
!/etc/nginx/sites-available/
!/etc/nginx/sites-available/**
!/etc/nginx/sites-enabled/
!/etc/nginx/sites-enabled/**
!/etc/nginx/conf.d/
!/etc/nginx/conf.d/**
